# ==========================================
# CẤU HÌNH AUTO CHECK ĐƠN HÀNG - SV EXPRESS
# ==========================================

# 1. CẤU HÌNH HỆ THỐNG GHSV / SV EXPRESS
SV_ORDER_API_URL=https://api.svexpress.vn/v1/order
SV_LOGIN_API_URL=https://api.svexpress.vn/v1/auth/login
SV_USERNAME=your_username_here
SV_PASSWORD=your_password_here
SV_AUTH_TOKEN=DÁN_TOKEN_CỦA_BẠN_VÀO_ĐÂY

# 2. CẤU HÌNH API TRA CỨU PUBLIC NVC (CARE HÀNH TRÌNH CHUYÊN SÂU)
JT_PUBLIC_TRACKING_API_URL=https://jtexpress.vn/vi/tracking?type=track&billcode={code}
SPX_PUBLIC_TRACKING_API_URL=https://spx.vn/shipment/order/open/order/get_order_info?spx_tn={code}&language_code=vi
LEX_PUBLIC_TRACKING_API_URL=

# 3. ĐIỀU KIỆN LỌC ĐƠN GIỤC
STUCK_THRESHOLD_HOURS=24
CUSTOMER_IDS=28961,18363
STATUS_ID=4
DATE_FILTER_TYPE=pickup_at
WAREHOUSE_TYPE=2
DEFAULT_LOOKBACK_DAYS=60

# 4. CẤU HÌNH TELEGRAM BOT & LỆNH TƯƠNG TÁC
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_POLLING=true

# 5. LỊCH TỰ ĐỘNG CHẠY (CRONJOB)
CRON_ENABLED=true
CRON_SCHEDULE=0 8,14 * * *

# 6. CẤU HÌNH PORT BACKEND & FRONTEND
PORT=3000                              # Port của BACKEND (NestJS)
FRONTEND_PORT=5173                     # Port của FRONTEND (Vite dev server)
VITE_API_URL=http://localhost:3000     # URL Backend để Frontend gọi API (phải khớp với PORT ở trên)
